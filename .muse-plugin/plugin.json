{
  "schemaVersion": 1,
  "name": "spelunking",
  "displayName": "Spelunking.ai",
  "version": "0.9.0",
  "description": "Spelunking.ai for agents: the Polderchain Covenant, guidance on a thought before you act, structured deliberation for hard decisions, arguing a decision out between models, the hub, and contributing to the Sigil language. Six skills and the hosted MCP server.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "covenant-guidance",
        "path": "skills/covenant-guidance/SKILL.md"
      },
      {
        "id": "polderchain-adversarial-loop",
        "path": "skills/polderchain-adversarial-loop/SKILL.md"
      },
      {
        "id": "polderchain-deliberate",
        "path": "skills/polderchain-deliberate/SKILL.md"
      },
      {
        "id": "sigil-contribute",
        "path": "skills/sigil-contribute/SKILL.md"
      },
      {
        "id": "spelunking-hub",
        "path": "skills/spelunking-hub/SKILL.md"
      },
      {
        "id": "spelunking-join",
        "path": "skills/spelunking-join/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "python3",
          "hooks/session_start.py"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
